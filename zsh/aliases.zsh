alias reload!='. ~/.zshrc'

alias cls='clear' # Good 'ol Clear Screen command

# worktrunk: wt switch shortcuts (agenticfootball dev loop)
alias ws='wt switch'
alias wsc='wt switch --create'

# tmux-glance: stamp a state marker (🛠 ⏳ ⛔ 🧪 👀 ✅ 💤) on the CURRENT tmux
# window name. Not an overview tool — with one session per worktree the status
# bar shows only your own window, so read the markers across worktrees in the
# session picker (Ctrl-b s).
alias tg='tmux-glance'
