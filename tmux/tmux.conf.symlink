# ═══════════════════════════════════════════════════════════════════
#  tmux — persistence layer for the parallel-agent worksetup
#  Docs: ~/.config/worksetup.md
#
#  One tmux session per git worktree/branch, created by `wts`.
#  kitty owns the on-screen layout (splits + Cmd+Shift+Enter zoom);
#  tmux owns persistence — sessions survive closing kitty entirely.
#
#  Prefix stays Ctrl-b.
# ═══════════════════════════════════════════════════════════════════

# ── Core ───────────────────────────────────────────────────────────
set  -g mouse on
set  -g base-index 1              # windows count from 1
setw -g pane-base-index 1
set  -g renumber-windows on
set  -g history-limit 50000       # long agent transcripts
set  -g focus-events on
set -sg escape-time 0             # no ESC lag inside Claude / vim
set  -g display-time 2000

# True colour + kitty graphics passthrough. Without allow-passthrough,
# tmux swallows kitty's image protocol and inline images render as junk.
set  -g default-terminal "tmux-256color"
set -as terminal-features ",xterm-kitty:RGB"
set  -g allow-passthrough on

# Let kitty's tab title show which session this pane holds.
set  -g set-titles on
set  -g set-titles-string "#{?#{@short},#{@short},#S}"

# ── Panes ──────────────────────────────────────────────────────────
bind h select-pane -L
bind j select-pane -D
bind k select-pane -U
bind l select-pane -R

bind -r H resize-pane -L 5
bind -r J resize-pane -D 5
bind -r K resize-pane -U 5
bind -r L resize-pane -R 5

# Splits inherit the worktree directory (tmux defaults to ~).
bind '"' split-window -v -c "#{pane_current_path}"
bind %   split-window -h -c "#{pane_current_path}"
bind c   new-window      -c "#{pane_current_path}"

# ── Reload ─────────────────────────────────────────────────────────
bind r source-file ~/.tmux.conf \; display "tmux.conf reloaded"

# ── Status bar ─────────────────────────────────────────────────────
# Session names are full branch names (long). @short holds the ticket
# id, set by `wts`; sessions made by hand fall back to the full name.
#
# Agent state: @agent is set per session by `tmux-agent-state`, called from
# Claude Code hooks (~/.claude/settings.json). working | waiting | done | unset.
#   badge  blue = working / no agent, AMBER = waiting on you, green = done
#   strip  every session on the right, so you still see who needs you while
#          one kitty pane is zoomed:  429● 436✓ 492◆ 738
set -g status-interval     5
set -g status-style        "bg=colour236,fg=colour246"
set -g status-left-length  80
# Branch slug: the session name minus `arnlaugsson-fut-513-`, capped at 65.
# Expanded with #{E:@slug}; shown after the badge unless it equals the badge
# (e.g. `main`).
set -g @slug "#{=/65/…:#{s/^([a-z]+-)?[a-z]+-[0-9]+-//:session_name}}"
set -g status-left         "#[bg=#{?#{==:#{@agent},waiting},colour214,#{?#{==:#{@agent},done},colour71,colour39}},fg=colour236,bold] #{?#{@short},#{@short},#S}#{?#{==:#{@agent},waiting}, ◆ waiting,} #[default] #{?#{==:#{E:@slug},#{?#{@short},#{@short},#S}},,#[fg=colour252]#{E:@slug}#[default] }"
# The window list only earns its space when a session has more than one
# window; with one it would just repeat the pane's process title (claude's
# version number).
set -g window-status-format         "#{?#{==:#{session_windows},1},,#I:#W#{?window_flags,#{window_flags}, }}"
set -g window-status-current-format "#{?#{==:#{session_windows},1},,#I:#W#{?window_flags,#{window_flags}, }}"
set -g status-right-length 120
# One entry per session, sorted by name; the second branch renders the current
# session (dim — its badge is already on the left). `fut-` is stripped to fit.
set -g status-right        "#{S/n:#[fg=#{?#{==:#{@agent},waiting},colour214#,bold,#{?#{==:#{@agent},done},colour71,#{?#{==:#{@agent},working},colour39,colour244}}}]#{s/fut-//:#{?#{@short},#{@short},#{session_name}}}#{?#{==:#{@agent},waiting},◆,#{?#{==:#{@agent},done},✓,#{?#{==:#{@agent},working},●,}}}#[default] ,#[fg=colour240]#{s/fut-//:#{?#{@short},#{@short},#{session_name}}}#[default] }"
set -g window-status-current-style "fg=colour39,bold"

# Session picker: zoomed, sessions collapsed, agent state next to the label.
bind s choose-tree -Zs -O name -F "#{?#{==:#{@agent},waiting},#[fg=colour214]◆ waiting ,#{?#{==:#{@agent},done},#[fg=colour71]✓ done    ,#{?#{==:#{@agent},working},#[fg=colour39]● working ,          }}}#[default]#{?#{@short},#{@short},#{session_name}}"

# ── Plugins (tpm) ──────────────────────────────────────────────────
# Reboot survival. resurrect restores session/window/pane structure,
# names, layouts and working directories — NOT running processes. Your
# agents will not come back mid-run; `claude --continue` in the restored
# worktree picks the conversation up again.
set -g @plugin 'tmux-plugins/tpm'
set -g @plugin 'tmux-plugins/tmux-resurrect'
set -g @plugin 'tmux-plugins/tmux-continuum'

set -g @resurrect-capture-pane-contents 'on'   # keep scrollback
set -g @continuum-restore   'on'               # restore when tmux next starts
set -g @continuum-save-interval '15'           # minutes

# resurrect does not save custom session options, so wts's @short label is lost
# on restore. resurrect has no post-restore hook, so use tmux's own: this fires
# for restored sessions and for any session made outside wts.
set-hook -g session-created 'run-shell "$HOME/.dotfiles/bin/tmux-session-label"'

# Keep this the LAST line in the file.
run '~/.tmux/plugins/tpm/tpm'
